# Public URL of the site, used for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave unset until real, approved content is live. While unset, every page is
# noindex and robots.txt disallows crawling.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Newsletter (https://buttondown.com). Without this, the form says sign-ups are closed.
# BUTTONDOWN_API_KEY=

# Contact form (https://resend.com). All three are needed, otherwise the form says
# messages can't be sent. CONTACT_FROM_EMAIL must be on a domain verified in Resend.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
